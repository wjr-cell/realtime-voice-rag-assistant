# 复制为 .env 后填写。不要把 .env 提交到 Git。

# 火山引擎访问密钥：https://console.volcengine.com/iam/keymanage/
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# 方舟推理接入点与 API Key
ARK_ENDPOINT_ID=
ARK_API_KEY=

# RTC 应用。AppKey 只保存在服务端，不要写进前端。
RTC_APP_ID=
RTC_APP_KEY=

# RTC 云端回调可访问的公网地址，例如 https://example.com
# 仅本机或私网开发时可以留空。
SERVER_URL=

# 知识库
VOLC_ACCOUNT_ID=
KB_COLLECTION_NAME=
# KB_PROJECT_NAME=default

# 语音识别与语音合成共用的 AppId
SPEECH_APP_ID=
# 如需分别指定，可改用下面两项，并覆盖上面的公共 AppId
# ASR_APP_ID=
# TTS_APP_ID=

# 额外允许的前端 Origin，逗号分隔
# CORS_ORIGINS=
